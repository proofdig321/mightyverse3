# Web production environment variables (sample)

# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Mighty Verse"

# Database
DATABASE_URL=postgres://mv_user:password@db.example.com:5432/mightyverse

# Supabase (if used)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage (S3-compatible)
S3_BUCKET=mightyverse-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME

# Livepeer
LIVEPEER_API_KEY=REPLACE_ME

# JWT
JWT_SECRET=REPLACE_ME

# MCP
MCP_AUTH_TOKEN=REPLACE_ME

# Monitoring
SENTRY_DSN=REPLACE_ME

# Optional
CDN_URL=https://cdn.example.com
